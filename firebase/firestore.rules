rules_version = '2';
// Reglas de seguridad de Firestore para Restobar POS.
//
// CÓMO APLICARLAS:
// 1. Consola Firebase → Firestore Database → pestaña "Reglas"
// 2. Pega TODO este contenido y toca "Publicar".
//
// Modelo:
//  - Solo usuarios AUTENTICADOS pueden leer/escribir los datos del negocio.
//  - La colección 'usuarios' guarda el rol (admin/mozo) por UID:
//      cada usuario puede LEER su propio documento (para saber su rol),
//      pero NADIE lo puede escribir desde la app (los roles se asignan
//      manualmente en la consola de Firebase). Así un mozo no puede
//      auto-ascenderse a admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario (rol). Lectura solo del propio documento; escritura bloqueada.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Datos del negocio: cualquier usuario autenticado puede leer y escribir.
    match /mesas/{id}        { allow read, write: if request.auth != null; }
    match /categorias/{id}   { allow read, write: if request.auth != null; }
    match /productos/{id}    { allow read, write: if request.auth != null; }
    match /comandas/{id}     { allow read, write: if request.auth != null; }
    match /cuentas/{id}      { allow read, write: if request.auth != null; }
    match /sesiones/{id}     { allow read, write: if request.auth != null; }
    match /movimientos/{id}  { allow read, write: if request.auth != null; }
    match /meta/{id}         { allow read, write: if request.auth != null; }
  }
}
