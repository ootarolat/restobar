rules_version = '2';
// Reglas de seguridad de Firestore para Restobar POS.
//
// CÓMO APLICARLAS (desde la carpeta del proyecto, con Firebase CLI):
//   firebase deploy --only firestore:rules
// Alternativa: Consola Firebase → Firestore Database → "Reglas" →
// pegar TODO este contenido → "Publicar".
//
// Roles (campo 'role' en usuarios/{uid}; sin documento = 'mozo'):
//   admin   → todo
//   cajero  → mesas, comandas, cobro y caja
//   mozo    → mesas, comandas y cobro
//   <estación> (cocina, bar, u otra creada en Configuración → Estaciones)
//           → solo LEE y cambia el estado de las tandas de las comandas
//             (no puede tocar items/precios, mesas, ventas ni caja)
//
// Los roles los administra el admin desde la app (Configuración → Usuarios),
// que escribe usuarios/{uid}: { name, email, role, roles[], activo, ... }.
//   role   = rol principal (admin > cajero > mozo > estación); es el que usan
//            estas reglas.
//   roles  = lista completa (informativa para la app).
//   activo = false → usuario dado de baja: pierde TODO acceso (lectura y
//            escritura) aunque su cuenta de Auth siga existiendo.
// Sin documento = 'mozo' activo (compatibilidad con usuarios antiguos).
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    // Usuario activo: sin documento (antiguo) o con activo distinto de false
    function active() {
      return !exists(userDoc()) || get(userDoc()).data.get('activo', true) != false;
    }
    function signedIn() {
      return request.auth != null && active();
    }
    function role() {
      return exists(userDoc()) ? get(userDoc()).data.get('role', 'mozo') : 'mozo';
    }
    function isAdmin()  { return signedIn() && role() == 'admin'; }
    function isCajero() { return signedIn() && role() == 'cajero'; }
    // Quienes atienden mesas y cobran
    function isStaff()  { return signedIn() && role() in ['admin', 'mozo', 'cajero']; }
    // Cualquier otro rol es una estación de preparación (cocina, bar, ...)
    function isEstacion() { return signedIn() && !(role() in ['admin', 'mozo', 'cajero']); }

    // Perfil de usuario. Cada uno lee el suyo (incluso dado de baja, para que
    // la app lo detecte); el admin lee todos y los crea/edita. Nunca se borran
    // (la baja es lógica: activo=false). El admin no puede quitarse a sí mismo
    // el rol admin ni darse de baja.
    function perfilValido() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.role is string && d.role.size() > 0 && d.role.size() <= 30
        && d.roles is list && d.roles.size() >= 1 && d.roles.size() <= 6
        && d.role in d.roles
        && d.get('activo', true) is bool;
    }
    function noAutoDegradar(uid) {
      return request.auth.uid != uid
        || (request.resource.data.role == 'admin' && request.resource.data.get('activo', true) == true);
    }
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() && perfilValido() && noAutoDegradar(uid);
      allow delete: if false;
    }
    // Carta y configuración: todos leen, solo el admin escribe
    match /categorias/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /productos/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /meta/{id}         { allow read: if signedIn(); allow write: if isAdmin(); }

    // Mesas: las gestiona el personal de sala
    match /mesas/{id}        { allow read: if signedIn(); allow write: if isStaff(); }

    // Comandas: el personal de sala crea/modifica/borra.
    // Las estaciones solo pueden modificar 'tandas' (estado, líneas listas).
    match /comandas/{id} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff() ||
        (isEstacion() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tandas', 'updatedAt']));
    }

    // Ventas: se crean al cobrar (mozo/cajero/admin); solo el admin
    // puede corregirlas o borrarlas (mantenimiento).
    match /cuentas/{id} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Movimientos de caja: ingresos al cobrar; egresos desde la caja.
    match /movimientos/{id} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Inventario: todos leen (el mozo lo necesita para bloquear productos
    // sin stock). El admin gestiona todo. El personal de sala, al enviar o
    // anular pedidos, solo puede mover el STOCK (incremento) y registrar
    // movimientos de venta, devolución o merma por anulación.
    match /insumos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
    }
    match /recetas/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /inventario/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow create: if isStaff() && request.resource.data.tipo in ['venta', 'devolucion', 'merma'];
    }
    // Aperturas/cierres de caja
    match /sesiones/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isCajero();
    }
  }
}
